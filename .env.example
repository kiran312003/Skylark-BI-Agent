# ─── Required ───────────────────────────────────────────────
# PostgreSQL connection string.
# Needed for `next build` to succeed (the /api/health route loads the DB).
# Free options: Neon (https://neon.tech), Supabase, or Aiven free Postgres.
# Local default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── Optional (defaults) ────────────────────────────────────
# If set, used as fallbacks. Users can also enter these in the UI at runtime
# (stored only in browser localStorage, never persisted on the server).
MONDAY_API_KEY=
OPENAI_API_KEY=

# Optional: point the OpenAI SDK at a free OpenAI-compatible provider.
# e.g. Groq  -> https://api.groq.com/openai/v1
#      OpenRouter -> https://openrouter.ai/api/v1
# Leave empty to use OpenAI's official endpoint.
OPENAI_BASE_URL=

# Optional: override the chat model (e.g. llama-3.3-70b-versatile on Groq).
OPENAI_MODEL=gpt-4o
